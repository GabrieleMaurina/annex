{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "exclude": ["dist", "test", "node_modules"],
  "ts-node": {
    "compilerOptions": {
      "rootDir": ".",
      "composite": false,
      "declaration": false
    }
  }
}

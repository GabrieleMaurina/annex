{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "predev": "tsc -b ../engine",
    "dev": "npm run kill && concurrently -k -n engine,server \"tsc -b ../engine --watch --preserveWatchOutput\" \"nodemon --exec ts-node src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "types": "tsc --noEmit",
    "check": "npm run format && npm run lint && npm run types",
    "kill": "ts-node -P scripts/tsconfig.json scripts/kill-port.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "engine": "*",
    "express": "^5.2.1",
    "obscenity": "^0.4.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
